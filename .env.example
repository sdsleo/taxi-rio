# Taxi.Rio — Variaveis de Ambiente de Exemplo (Desenvolvimento Local)
# Copie este arquivo para .env ao executar fora do Docker

NODE_ENV=development

# ----------------------------------------
# Configuracoes da API
# ----------------------------------------
PORT=3000
JWT_SECRET=dev_jwt_secret_key_taxi_rio_super_secure_example

# ----------------------------------------
# MySQL (Fonte da Verdade)
# ----------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=taxirio_user
MYSQL_PASSWORD=taxirio_pass
MYSQL_DATABASE=taxirio

# ----------------------------------------
# Redis (Cache de Status da Corrida)
# ----------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ----------------------------------------
# MongoDB (Auditoria e Historico de Eventos)
# ----------------------------------------
MONGO_URI=mongodb://mongoadmin:mongopassword@localhost:27017/taxirio_audit?authSource=admin

# ----------------------------------------
# RabbitMQ (Mensageria / Eventos)
# ----------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ----------------------------------------
# Worker
# ----------------------------------------
WORKER_METRICS_PORT=3001

# ----------------------------------------
# OpenTelemetry & Tracing (Jaeger)
# ----------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=taxi-rio-api
OTEL_TRACING_ENABLED=true
